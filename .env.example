# OpenRouter API Key for AI Playground (Required for live chat in playground)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Public site URL for OpenRouter ranking headers
NEXT_PUBLIC_APP_URL=https://theaisignal.vercel.app

# Optional: SQLite Database path (defaults to data/usage-history.sqlite locally and /tmp/usage-history.sqlite on Vercel)
# SQLITE_DB_PATH=data/usage-history.sqlite
